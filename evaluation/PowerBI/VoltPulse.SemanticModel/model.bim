        "lineageTag": "35bc01ca-f448-4b3a-9c71-677c068e8c8b",
        "measures": [
          {
            "name": "Session count",
            "expression": "COUNTROWS(Sessions)",
            "formatString": "#,0",
            "lineageTag": "eff852db-aec4-488f-bc22-d60235053ffa"
          },
          {
            "name": "Energy MWh",
            "expression": "DIVIDE(SUM(Sessions[Energy_kWh]),1000)",
            "formatString": "#,0.00",
            "lineageTag": "4c949f83-5766-4d4e-9725-2024cb1d4030"
          },
          {
            "name": "Mean active minutes",
            "expression": "AVERAGE(Sessions[Charging_Mins])",
            "formatString": "#,0.00",
            "lineageTag": "c09ef737-ddb8-4117-8f0b-bc9579c1da28"
          },
          {
            "name": "Mean energy kWh",
            "expression": "AVERAGE(Sessions[Energy_kWh])",
            "formatString": "#,0.00",
            "lineageTag": "d00db3bf-d9df-4240-bb5e-aa755dbe2f79"
          },
          {
            "name": "Mean connected minutes",
            "expression": "AVERAGE(Sessions[Duration_Mins])",
            "formatString": "#,0.00",
            "lineageTag": "1a271949-d738-40e0-857e-4ddc527943b7"
          },
          {
            "name": "Mean idle minutes",
            "expression": "AVERAGEX(Sessions, Sessions[Duration_Mins] - Sessions[Charging_Mins])",
            "formatString": "#,0.00",
            "lineageTag": "6d685e8b-ae1c-4f70-8d54-9966cd0ec995"
          },
          {
            "name": "Station count",
            "expression": "DISTINCTCOUNT(Sessions[Station_Name])",
            "formatString": "#,0",
            "lineageTag": "031422bf-7137-4fc1-9176-a8c332f926e1"
          }
        ],
        "partitions": [
          {
            "name": "Sessions",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Bytes = Binary.Decompress(Binary.FromText(Text.Combine({\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"}), BinaryEncoding.Base64), Compression.Deflate),",
                "    Raw = Csv.Document(Bytes, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Hour\", Int64.Type},{\"Energy_kWh\",type number},{\"Duration_Mins\",type number},{\"Charging_Mins\",type number},{\"Start_Date_Time\",type datetime}}, \"en-US\"),",
                "    Days = Table.AddColumn(Typed,\"Weekday\",each Date.ToText(Date.From([Start_Date_Time]),\"ddd\",\"en-US\"),type text),",
                "    Months = Table.AddColumn(Days,\"Month\",each Date.ToText(Date.From([Start_Date_Time]),\"yyyy-MM\",\"en-US\"),type text)",
                "in",
                "    Months"
              ],
              "type": "m"
            }
          }
        ]
      },
